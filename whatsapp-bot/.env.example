# Copy to .env (or export in your shell) before `npm start`
AGENT_NAME=Your Name, OIC Agent
MERGE_WAIT_SECONDS=45
REPLY_IN_GROUPS=0
# Which groups to answer in (exact group names, comma-separated). Empty = all groups.
# The bot prints your group names when it starts.
ALLOW_GROUPS=
# Only auto-reply to these numbers (country code + number, digits only). Empty = everyone.
ALLOW_NUMBERS=
AUTO_QUOTE=1
AUTO_PDF=1
# INBOX_DIR=/path/to/inbox
# Which calculator to price with: a file path or a URL. If empty, the bot uses
# ../index.html when present, otherwise the live site below.
# CALCULATOR_HTML=https://nvkoicl.github.io/PREMIUM-CALCULATOR/
